<body>
  <Header lang="en" pairUrl="/Circle-of-Life/zh/virtual-cell-paradox/" />
  <div id="vcp-root" class="light">
    <Fragment set:html={articleHtml} />
  </div>
  <Footer />
  <script is:inline src="/Circle-of-Life/virtual-cell-paradox/essay-en.js" defer></script>
</body>
</html>
