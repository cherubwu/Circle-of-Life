---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import articleHtml from '../data/virtual-cell-paradox-article-en.html?raw';
---
<html lang="en">
<head>
  <BaseHead title="The Virtual Cell Paradox | Circle of Life" description="Can virtual cells predict biology across age, disease, species and perturbations—and do they meaningfully help wet-lab science? An interactive scientific essay." />
  <link rel="stylesheet" href="/Circle-of-Life/virtual-cell-paradox/essay.css" />
</head>
<body>
  <Header lang="en" pairUrl="/Circle-of-Life/zh/virtual-cell-paradox/" />
  <nav class="essay-breadcrumb" aria-label="Breadcrumb">
    <a href="/Circle-of-Life/blog/">Articles</a><span aria-hidden="true"> / </span>
    <a href="/Circle-of-Life/blog/metabolism/">Metabolism</a><span aria-hidden="true"> / </span>
    <span>Interactive Essay</span>
  </nav>
  <div id="vcp-root" class="light">
    <Fragment set:html={articleHtml} />
  </div>
  <Footer />
  <script is:inline src="/Circle-of-Life/virtual-cell-paradox/essay-en.js" defer></script>
</body>
</html>

<style>
.essay-breadcrumb{max-width:1280px;margin:0 auto;padding:1rem 4vw;display:flex;flex-wrap:wrap;gap:.5rem;font-size:.8rem;color:#35204f}
.essay-breadcrumb a{color:#35204f;text-underline-offset:3px}
</style>
