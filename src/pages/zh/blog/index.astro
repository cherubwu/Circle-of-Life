---
import BaseHead from '../../../components/BaseHead.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => data.lang === 'zh'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<html lang="zh">
<head>
  <BaseHead title="文章 | 生之回环" description="生之回环所有文章" />
</head>
<body>
  <Header />
  <main>
    <h1>文章</h1>
    <a class="essay-feature" href="/Circle-of-Life/zh/virtual-cell-paradox/">
      <span>✳ INTERACTIVE ESSAY · 2026</span>
      <strong>The Virtual Cell Paradox — 如果生命最终需要真实验证，我们为什么还要模拟它？</strong>
      <small>细胞图谱、跨物种、扰动预测、产业格局与临床证据 · 进入交互长文 ↗</small>
    </a>
    <ul class="post-list">
      {posts.map(post => (
        <li>
          <a href={`/Circle-of-Life/zh/blog/${post.id}/`}>{post.data.title}</a>
          <span class="meta">
            {post.data.pubDate.toLocaleDateString('zh-CN')}
            {post.data.tags?.map(tag => <span class="tag">{tag}</span>)}
          </span>
          <p class="desc">{post.data.description}</p>
        </li>
      ))}
    </ul>
  </main>
  <Footer />
</body>
</html>

<style>
.post-list { list-style: none; padding: 0; }
.post-list li { padding: 1.5rem 0; border-bottom: 1px solid var(--border); }
.post-list a { font-size: 1.2rem; font-weight: 600; color: var(--text); }
.post-list a:hover { color: var(--accent-2); }
.meta { display: block; font-size: 0.85rem; color: var(--text-muted); margin: 0.3rem 0; }
.desc { color: var(--text-muted); margin: 0.3rem 0 0; font-size: 0.95rem; }
.essay-feature{display:block;background:#F7E623;color:#000;text-decoration:none;border:3px solid #000;box-shadow:8px 8px 0 #000;padding:22px 25px;margin:30px 0 45px}
.essay-feature:hover{color:#000;transform:translate(-2px,-2px);box-shadow:10px 10px 0 #000}
.essay-feature span{display:block;font-weight:800;font-size:10px;letter-spacing:.14em}
.essay-feature strong{font-family:'Archivo Black','Noto Sans SC',sans-serif;display:block;font-size:clamp(1.15rem,2.7vw,1.7rem);line-height:1.4;margin:8px 0}
.essay-feature small{display:block;font-size:.85rem;color:#333}
</style>
